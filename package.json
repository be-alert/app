{
  "name": "be-alert",
  "private": true,
  "version": "3.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build:pages": "vite build --mode pages && node scripts/spa-fallback.mjs && node scripts/prerender-legal.mjs pages",
    "deploy:pages": "npm run build:pages && gh-pages -d dist --dotfiles -m \"Deploy Be Alert\"",
    "build:android": "vite build --mode android && node -e \"require('fs').rmSync('dist/screenshots',{recursive:true,force:true})\" && cap sync android",
    "apk": "npm run build:android && cd android && gradlew.bat assembleDebug",
    "icons": "node scripts/make-icons.mjs",
    "release": "npm run build:android && cd android && gradlew.bat bundleRelease assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "8.5.11",
    "@supabase/supabase-js": "^2.57.4",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.9.1",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "description": "Be Alert — hyperlocal community app: alerts, deals, services, transport and community within 1–50 km.",
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
